/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' blob: data:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# The staged assets live under /toolchain/<toolchain-id>/, one driver and one
# archive per toolchain (see toolchains.json), so these patterns are written for
# that nesting. Both spellings are listed because whether the wildcard in a
# _headers pattern crosses a directory separator is host-specific, and a driver
# served as text/wasm without its Content-Encoding fails to instantiate.
/toolchain/*.wasm.br
  Content-Type: application/wasm
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable, no-transform

/toolchain/*/*.wasm.br
  Content-Type: application/wasm
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable, no-transform

/toolchain/*.tar.gzip
  Content-Type: application/gzip
  Cache-Control: public, max-age=31536000, immutable, no-transform

/toolchain/*/*.tar.gzip
  Content-Type: application/gzip
  Cache-Control: public, max-age=31536000, immutable, no-transform

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sim-runner.wasm.br
  Content-Type: application/wasm
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable, no-transform