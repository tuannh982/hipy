diff --git a/amd/insts/decodetable_test.go b/amd/insts/decodetable_test.go
new file mode 100644
index 0000000..74a372f
--- /dev/null
+++ b/amd/insts/decodetable_test.go
@@ -0,0 +1,44 @@
+package insts_test
+
+import (
+	"testing"
+
+	"github.com/sarchlab/mgpusim/v5/amd/insts"
+)
+
+// VOP1 opcode 56 is two instructions depending on the target: v_movrelsd_b32, a
+// DS-relative store, on gfx9, and v_mov_b64, a 64-bit register move, on gfx940+,
+// which is where LLVM gates it. The decode table is a single architecture-agnostic
+// list, so one entry has to name the one this table is used for -- and a 64-bit
+// register move decoded as a 32-bit one copies the low word of every pair and leaves
+// the high word stale, which reads downstream as a corrupted address rather than as
+// a missing instruction.
+//
+// This is the assertion that fails if the entry is reverted. It cannot live in the
+// cdna3 emulator test, which builds its operands by hand and so never sees the
+// widths the table supplies.
+func TestVOP1Opcode56DecodesAsVMOVB64(t *testing.T) {
+	// v_mov_b64_e32 v[0:1], v[2:3]: VOP1 is Encoding 0x7E000000 under Mask
+	// 0xFE000000, opcode in bits 16..9, source in bits 8..0 and destination in bits
+	// 24..17. This is the word clang emits for the pair copy in
+	// website/tests/fixtures/cdna3-mov-b64.cu, verified with cmd/instdump.
+	buf := []byte{0x02, 0x71, 0x00, 0x7e}
+
+	inst, err := insts.NewDisassembler().Decode(buf)
+	if err != nil {
+		t.Fatalf("decode 0x7e007102: %v", err)
+	}
+	if inst.InstType == nil {
+		t.Fatal("0x7e007102 decoded with no instruction type")
+	}
+	if inst.InstType.InstName != "v_mov_b64" {
+		t.Errorf("VOP1 opcode 56 decoded as %q, want v_mov_b64", inst.InstType.InstName)
+	}
+	if inst.DSTWidth != 64 || inst.SRC0Width != 64 {
+		t.Errorf("VOP1 opcode 56 has dst width %d and src0 width %d, want 64 and 64: a 32-bit pair copy drops the high word of every pair",
+			inst.DSTWidth, inst.SRC0Width)
+	}
+	if inst.Dst.RegCount != 2 || inst.Src0.RegCount != 2 {
+		t.Errorf("VOP1 opcode 56 decoded %d destination and %d source registers, want 2 and 2", inst.Dst.RegCount, inst.Src0.RegCount)
+	}
+}
