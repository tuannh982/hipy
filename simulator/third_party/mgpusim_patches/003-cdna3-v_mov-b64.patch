--- a/amd/emu/cdna3/sopk.go
+++ b/amd/emu/cdna3/sopk.go
@@ -46,17 +46,28 @@ func (u *ALU) runSOPK(state emu.InstEmuState) {
 	}
 }
 
+// runSMOVKI32 implements s_movk_i32: Dst = signext(SImm16) over all 32 bits.
+//
+// imm is already a sign-extended int16, so it has to reach WriteOperand as an
+// int16 and be widened there: converting it to its uint16 bits first (via
+// emu.Int16ToBits) throws the sign extension away and widens 0xffe4 to
+// 0x0000ffe4 instead of 0xffffffE4. That costs the upper half of every negative
+// immediate, and it stays invisible until the register is multiplied -- a
+// `s_movk_i32 sN, -28` feeding v_mad_i32_i24 against a work-item id produces a
+// result low by exactly lane<<16, which reads downstream as a corrupted
+// address. See amd/emu/gcn3/alusopk.go, which widens the int16 directly.
 func (u *ALU) runSMOVKI32(state emu.InstEmuState) {
 	inst := state.Inst()
 	imm := emu.AsInt16(uint16(state.ReadOperand(inst.SImm16, 0) & 0xffff))
-	state.WriteOperand(inst.Dst, 0, uint64(emu.Int16ToBits(imm)))
+	state.WriteOperand(inst.Dst, 0, uint64(imm))
 }
 
+// runSCMOVKI32 implements s_cmovk_i32: the s_movk_i32 write under SCC.
 func (u *ALU) runSCMOVKI32(state emu.InstEmuState) {
 	inst := state.Inst()
 	if state.SCC() == 1 {
 		imm := emu.AsInt16(uint16(state.ReadOperand(inst.SImm16, 0) & 0xffff))
-		state.WriteOperand(inst.Dst, 0, uint64(emu.Int16ToBits(imm)))
+		state.WriteOperand(inst.Dst, 0, uint64(imm))
 	}
 }
 
