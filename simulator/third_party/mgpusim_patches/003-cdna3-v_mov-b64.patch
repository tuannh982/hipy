+// the gfx9 spelling needs its M0/GPR-relative addressing back, which is the part it
+// never modelled in the first place.
+func (u *ALU) runVMOVB64(state emu.InstEmuState) {
 	inst := state.Inst()
 	exec := state.EXEC()
 	for i := 0; i < 64; i++ {
 		if exec&(1<<uint(i)) == 0 {
 			continue
 		}
-		src := math.Float32frombits(uint32(state.ReadOperand(inst.Src0, i)))
-		dst := float32(math.Log2(float64(src)))
-		state.WriteOperand(inst.Dst, i, uint64(math.Float32bits(dst)))
+		state.WriteOperand(inst.Dst, i, state.ReadOperand(inst.Src0, i))
 	}
