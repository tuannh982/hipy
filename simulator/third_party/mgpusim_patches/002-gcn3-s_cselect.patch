+// runSCSELECTB64 implements S_CSELECT_B64 (SOP2 opcode 11): dst = SCC ?
+// src0 : src1, as a 64-bit value, leaving SCC untouched.
+//
+// clang emits it for gfx803 in two places we hit: the unsigned-division expansion
+// behind gridDim/workgroupDim, and the address select for a dynamically indexed
+// private array. Upstream panics on the opcode.
+func (u *ALU) runSCSELECTB64(state emu.InstEmuState) {
+	inst := state.Inst()
+	src0 := state.ReadOperand(inst.Src0, 0)
+	src1 := state.ReadOperand(inst.Src1, 0)
+	scc := state.SCC()
+
+	if scc == 1 {
+		state.WriteOperand(inst.Dst, 0, src0)
+	} else {
+		state.WriteOperand(inst.Dst, 0, src1)
+	}
+}
