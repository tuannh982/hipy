+// applyUserSgprProperties decodes the descriptor's kernel_code_properties word
+// into the user-SGPR enables. Each bit reserves a fixed number of user SGPRs at
+// the front of the kernel's allocation, and the dispatcher fills s[0:...] in bit
+// order, so reading the wrong word shifts every later user SGPR: the kernarg
+// pointer, the workgroup IDs and the dispatch pointer land in registers the
+// compiled code never reads. That is why these are read rather than guessed.
+//
+// Bits 7-9 are KERNEL_CODE_PROPERTY_RESERVED0 in COV5, so there is no
+// grid-workgroup-count encoding and those enables stay false; a kernel reads the
+// grid dimensions from the AAMDQ dispatch packet instead.
+func applyUserSgprProperties(meta *KernelCodeObjectMeta, properties uint16) {
+	meta.EnableSgprPrivateSegmentBuffer = properties&(1<<0) != 0
+	meta.EnableSgprDispatchPtr = properties&(1<<1) != 0
+	meta.EnableSgprQueuePtr = properties&(1<<2) != 0
+	meta.EnableSgprKernargSegmentPtr = properties&(1<<3) != 0 ||
+		meta.KernargSegmentByteSize > 0
+	meta.EnableSgprDispatchID = properties&(1<<4) != 0
+	meta.EnableSgprFlatScratchInit = properties&(1<<5) != 0
+	meta.EnableSgprPrivateSegmentSize = properties&(1<<6) != 0
+}
+
+// userSgprCount totals the user SGPRs the enabled properties reserve, so it stays
+// consistent with the layout the wavefront dispatcher builds.
+func userSgprCount(meta *KernelCodeObjectMeta) uint32 {
+	count := uint32(0)
+	if meta.EnableSgprPrivateSegmentBuffer {
+		count += 4
+	}
+	if meta.EnableSgprDispatchPtr {
+		count += 2
+	}
+	if meta.EnableSgprQueuePtr {
+		count += 2
+	}
+	if meta.EnableSgprKernargSegmentPtr {
+		count += 2
+	}
+	if meta.EnableSgprDispatchID {
+		count += 2
+	}
+	if meta.EnableSgprFlatScratchInit {
+		count += 2
+	}
+	if meta.EnableSgprPrivateSegmentSize {
+		count++
+	}
+	return count
+}
