diff --git a/mem/cache/writeback/builder.go b/mem/cache/writeback/builder.go
index 92fe872..167463b 100644
--- a/mem/cache/writeback/builder.go
+++ b/mem/cache/writeback/builder.go
@@ -84,6 +84,23 @@ func (b Builder) Build(name string) *Comp {
 	blockSize := 1 << b.spec.Log2BlockSize
 	numSets := int(
 		b.spec.TotalByteSize / uint64(b.spec.WayAssociativity*blockSize))
+	// A cache too small for even ONE set is refused here rather than built.
+	//
+	// Every directory lookup computes its set as `hashedAddr % numSets`, so a zero
+	// set count does not fail at Build -- it panics with an integer divide by zero
+	// the first time the cache is touched, which is deep inside a simulation run
+	// and reads as a simulator bug rather than as the misconfiguration it is.
+	// Checked at the only point that still knows all three numbers involved.
+	//
+	// The message names the arithmetic rather than only the symptom, because the
+	// fix is a larger TotalByteSize and the caller needs to know by how much: one
+	// set needs WayAssociativity*blockSize bytes.
+	if numSets < 1 {
+		panic(fmt.Sprintf("writeback: %s: TotalByteSize %d is too small for %d-way %d-byte lines; "+
+			"one set needs %d bytes, so the cache needs at least that",
+			name, b.spec.TotalByteSize, b.spec.WayAssociativity, blockSize,
+			b.spec.WayAssociativity*blockSize))
+	}
 
 	spec := b.buildSpec(numSets)
 
diff --git a/mem/cache/writethroughcache/builder.go b/mem/cache/writethroughcache/builder.go
index b1358fa..9684819 100644
--- a/mem/cache/writethroughcache/builder.go
+++ b/mem/cache/writethroughcache/builder.go
@@ -94,6 +94,15 @@ func (b Builder) Build(name string) *Comp {
 	blockSize := 1 << spec.Log2BlockSize
 	spec.NumSets = int(spec.TotalByteSize /
 		uint64(spec.WayAssociativity*blockSize))
+	// A cache too small for even ONE set is refused here rather than built. See the
+	// note in the writeback builder: the failure would otherwise be an integer
+	// divide by zero on the first lookup, not a build error.
+	if spec.NumSets < 1 {
+		panic(fmt.Sprintf("writethroughcache: %s: TotalByteSize %d is too small for %d-way %d-byte lines; "+
+			"one set needs %d bytes, so the cache needs at least that",
+			name, spec.TotalByteSize, spec.WayAssociativity, blockSize,
+			spec.WayAssociativity*blockSize))
+	}
 
 	initialState := b.buildInitialState(name, spec, spec.NumSets, blockSize)
 
