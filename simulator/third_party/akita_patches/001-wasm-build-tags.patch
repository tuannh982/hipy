@@ -0,0 +1,18 @@
+//go:build js && wasm
+
+package daisen2
+
+type ProgressBar struct {
+	ID         uint64
+	Name       string
+	Total      uint64
+	Finished   uint64
+	InProgress uint64
+}
+
+func (b *ProgressBar) IncrementInProgress(amount uint64) { b.InProgress += amount }
+func (b *ProgressBar) IncrementFinished(amount uint64)   { b.Finished += amount }
+func (b *ProgressBar) MoveInProgressToFinished(amount uint64) {
+	b.InProgress -= amount
+	b.Finished += amount
+}
